{
  "name": "fermatta",
  "productName": "Fermatta",
  "version": "0.1.0",
  "description": "Запись игры на цифровом пианино, переозвучка концертным роялем, падающие ноты и видео.",
  "main": "src/main/main.js",
  "author": "Parzifalai",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "io.github.parzifalai.fermatta",
    "productName": "Fermatta",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Fermatta"
    }
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/golos-text": "^5.3.0",
    "fflate": "^0.8.3",
    "ffmpeg-static": "^5.3.0",
    "mp4-muxer": "^5.2.2",
    "opensheetmusicdisplay": "^2.2.1"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  }
}
